# Скопируйте в .env и заполните. .env никогда не коммитится (см. .gitignore).
# Файл читается и приложением (pydantic-settings), и docker-compose.

# ---------------------------------------------------------------- приложение
APP_NAME="OrderFlow Platform"
# development | staging | production — влияет на логи и Sentry environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# имя сервиса в метриках и логах (job в Prometheus)
SERVICE_NAME=orderflow-api

# ---------------------------------------------------------------- база данных
# В проде задаётся через .env на сервере, в CI — через переменные окружения.
DATABASE_URL=postgresql+asyncpg://orderflow:change-me@localhost:5432/orderflow

# ---------------------------------------------------------------- наблюдаемость
# Пусто = интеграция с Sentry отключена (логика env-based, см. app/core/sentry.py)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ---------------------------------------------------------------- CORS
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- деплой
# Задаёт deploy.sh перед docker compose pull/up; в git не хранится.
IMAGE_TAG=latest
GHCR_IMAGE=ghcr.io/alexgoster/orderflow-platform-api

# ---------------------------------------------------------------- TLS / nginx
DOMAIN=orderflow.example.com
# e-mail для certbot (подтверждения Let's Encrypt)
CERTBOT_EMAIL=ops@example.com

# ---------------------------------------------------------------- grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
